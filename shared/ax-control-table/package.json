{
  "name": "@ax-cowork/control-table",
  "version": "2.0.0",
  "description": "Virtualized data grid for AX Cowork (TanStack Table + Virtual + AntD primitives).",
  "private": true,
  "type": "module",
  "main": "./dist/ax-control-table.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/ax-control-table.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "concurrently -k -n vite,types -c blue,cyan \"vite build --watch\" \"tsc --emitDeclarationOnly --watch --preserveWatchOutput\"",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\""
  },
  "peerDependencies": {
    "@ant-design/icons": ">=6.0.0",
    "@tanstack/react-table": ">=8.0.0",
    "@tanstack/react-virtual": ">=3.0.0",
    "antd": ">=6.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.2.2",
    "@eslint/js": "^10.0.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "antd": "^6.3.7",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
