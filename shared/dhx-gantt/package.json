{
  "name": "@dhx/gantt",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "An open source JavaScript Gantt chart that helps you illustrate a project schedule in a nice-looking chart.",
  "main": "./dist/dhtmlxgantt.es.js",
  "module": "./dist/dhtmlxgantt.es.js",
  "types": "./dist/dhtmlxgantt.es.d.ts",
  "exports": {
    ".": {
      "import": "./dist/dhtmlxgantt.es.js",
      "types": "./dist/dhtmlxgantt.es.d.ts"
    },
    "./dist/dhtmlxgantt.css": "./dist/dhtmlxgantt.css"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "less": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.5.0"
  }
}
