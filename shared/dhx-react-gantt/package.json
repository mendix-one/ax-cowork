{
  "name": "@dhx/react-gantt",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/dhtmlxgantt.react.es.js",
  "module": "./dist/dhtmlxgantt.react.es.js",
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/dhtmlxgantt.react.es.js",
      "types": "./dist/types/index.d.ts"
    },
    "./dist/react-gantt.css": "./dist/react-gantt.css"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@dhx/gantt": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "lodash-es": "^4.17.21",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.5.0"
  },
  "scripts": {
    "build": "vite build",
    "bundle:dts": "rollup -c rollup.config.dts.js",
    "build:all": "yarn build && yarn bundle:dts",
    "watch": "vite build --watch",
    "generate:templates": "tsx scripts/generate-react-templates.ts",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\""
  }
}
