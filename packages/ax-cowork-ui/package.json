    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/view": "^6.34.0",
    "@dhx/react-gantt": "workspace:*",
    "@fontsource/roboto": "^5.2.10",
    "@mdi/js": "^7.4.47",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/core": "^2.10.0",
    "@tiptap/pm": "^2.10.0",
    "@tiptap/react": "^2.10.0",
    "@tiptap/starter-kit": "^2.10.0",
