    "mobx": "^6.15.2",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.6",
    "react-resizable-panels": "^4.11.0",
    "react-router-dom": "^7.15.0",
