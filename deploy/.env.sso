# Example env for the `sso` deployable (ax-sso-services).
# Copy to deploy/.env.sso and ROTATE the secrets below before any production use —
# values here are committed to git and must be considered public.

NODE_ENV=production
PORT=15501

# External MongoDB. Point at your managed cluster or an in-network mongo container.
# `mongo` here is a placeholder hostname — adjust to your topology.
MONGODB_URI=mongodb://ax:replace-with-strong-password@mongo:27017/ax-sso?authSource=admin

# Comma-separated list of accepted ax-axios-key header values. Must contain the BE's
# SSO_API_KEY (otherwise the BE gateway → SSO calls all 401).
API_KEYS=08fd4d0919a32441e2f119515d0ab468e1efca539d4ed73f7ed643c2359ed63d

# Must match the BE's SSO_JWT_SECRET so BE can verify session JWTs locally.
JWT_SECRET=ac6bb1c78fc5a48c3d82cf4edd4479671446690d1023d47c57462d9b4d26a491
JWT_EXPIRES_IN=24h
