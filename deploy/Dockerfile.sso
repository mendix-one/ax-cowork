# Runtime image for ax-sso-services.
# Jenkins runs `pnpm --filter ax-sso-services deploy --prod ./deploy/out/sso` first,
# so this image only copies the prebuilt artifact tree (dist/ + flat node_modules).
FROM node:24-alpine
WORKDIR /app

COPY ./deploy/out/sso/ ./
COPY ./deploy/out/sso/dist ./dist
COPY ./deploy/out/sso/node_modules ./node_modules
RUN pwd
RUN ls -a

ENV NODE_ENV=production
ENV PORT=15501

EXPOSE 15501

CMD ["node", "dist/main.js"]
