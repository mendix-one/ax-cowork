<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <base href="/">
  <link rel="icon" href="favicon.ico"/>

  {{#with meta}}
  <title>{{title}}</title>
  <meta name="thumbnail"                  content="{{image}}" />
  <meta name="description"                content="{{description}}"/>

  <meta name="keywords"                   content="{{keywords}}"/>
  <meta name="news_keywords"              content="{{keywords}}"/>

  <meta name="apple-mobile-web-app-capable"   content="yes"/>
  <meta name="apple-mobile-web-app-title"     content="{{title}}"/>

  <meta name="copyright"                  content="{{author}}"/>
  <meta name="author"                     content="{{author}}"/>
  <meta name="robots"                     content="index,follow"/>
  <meta name="geo.placename"              content="Ha Noi, Viet Nam"/>
  <meta name="geo.region"                 content="VN-HN"/>
  <meta name="geo.position"               content="21.030625;105.782435"/>
  <meta name="ICBM"                       content="21.030625, 105.782435"/>
  <meta name="revisit-after"              content="days"/>

  <link rel="canonical" href="{{canonical}}"/>
  <link rel="alternate" href="{{canonical}}" hreflang="{{lang}}"/>

  <!-- META FOR FACEBOOK -->
  <meta property="og:url"                content="{{canonical}}"/>
  <meta property="og:title"              content="{{title}}"/>
  <meta property="og:description"        content="{{description}}"/>
  <meta property="og:image"              content="{{image}}" />
  <meta property="og:image:alt"          content="{{title}}"/>
  <meta property="og:locale"             content="{{lang}}" />
  <!-- END META FOR FACEBOOK -->

  <!-- Twitter Card -->
  <meta name="twitter:card"               value="summary"/>
  <meta name="twitter:url"                content="{{canonical}}"/>
  <meta name="twitter:title"              content="{{title}}"/>
  <meta name="twitter:description"        content="{{description}}"/>
  <meta name="twitter:image"              content="{{image}}" />
  <meta name="twitter:site"               content="{{title}}"/>
  <meta name="twitter:creator"            content="{{author}}"/>
  <!-- End Twitter Card -->
  {{/with}}

  <script>
    var appInitialData = JSON.parse('{{{initial}}}')
  </script>

  {{#with assets}}
    <script type="module" crossorigin src="{{script}}"></script>
    {{#each styles}}
      <link rel="stylesheet" href="{{this}}" />
    {{/each}}
  {{/with}}
</head>
