{
  "name": "ax-cowork",
  "version": "1.1.0",
  "description": "AX Cowork monorepo: AI-assisted planning and document workspace (front-end, back-end, shared).",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "dev:fe": "pnpm --filter ax-cowork-ui run dev",
    "dev:be": "pnpm --filter ax-cowork-be run dev",
    "dev:cdn": "pnpm --filter ax-cdn-services run dev",
    "dev:sso": "pnpm --filter ax-sso-services run dev",
    "dev:di": "pnpm --filter ax-data-integration run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2"
  }
}
