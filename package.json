{
  "name": "ax-cowork",
  "version": "1.1.0",
  "description": "AX Cowork monorepo: AI-assisted planning and document workspace (front-end, back-end, shared).",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @ax/react-app run dev",
    "dev:app": "pnpm --filter @ax/react-app run dev",
    "dev:sim": "pnpm --filter @ax/simulation run dev",
    "build": "pnpm -r run build",
    "build:login": "pnpm --filter @ax/login run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:app": "prettier --write react-app",
    "format:sim": "prettier --write simulation",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "^19.2.6",
        "react-dom": "^19.2.6"
      },
      "ignoreMissing": [
        "react-native"
      ]
    },
    "onlyBuiltDependencies": [],
    "overrides": {
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "@mendix/pluggable-widgets-tools": "^11.8.1"
    },
    "allowUnusedPatches": true,
    "patchedDependencies": {
      "mobx-react-lite@4.0.7": "patches/mobx-react-lite@4.0.7.patch",
      "mobx@6.12.3": "patches/mobx@6.12.3.patch"
    },
    "ignoredBuiltDependencies": [
      "core-js"
    ]
  }
}
