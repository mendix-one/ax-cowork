# Copy to `.env` next to docker-compose.yml and edit before `docker compose up`.
# The two `:?` vars at the bottom of compose REQUIRE a value — compose refuses to
# start without them. Everything else has a sane default and can stay unset.

# --- Required ---------------------------------------------------------------

# Comma-separated API keys. Generate something opaque, e.g.
#   openssl rand -hex 24
INTEGRATION_API_KEYS=replace-me-with-a-real-key

# Base64-encoded 32 random bytes (AES-256 master key). Generate with:
#   openssl rand -base64 32
INTEGRATION_MASTER_KEY_V1=replace-me-with-base64-of-32-bytes

# --- Optional (defaults shown match the service) ----------------------------

# LOG_LEVEL=info
# MONGO_DB_NAME=ax_data_integration
# MONGO_POOL_SIZE=10

# INTEGRATION_MASTER_KEY_CURRENT=1
# INTEGRATION_DEFAULT_TIMEZONE=UTC
# INTEGRATION_DEFAULT_ERROR_THRESHOLD=100
# INTEGRATION_MAX_CONCURRENT_RUNS=5
# INTEGRATION_HEARTBEAT_INTERVAL_MS=30000
# INTEGRATION_STALE_HEARTBEAT_TIMEOUT_MS=120000
# INTEGRATION_STALE_SWEEP_INTERVAL_MS=60000
# INTEGRATION_CHANGELOG_BUFFER_SIZE=100

# --- Host port mapping (compose-only, never seen by the app) ----------------

# SERVICE_HOST_PORT=3012
# SERVICE_HOST_PORT_PROD=3013      # used by `--profile prod` (T2-A11)
# MONGO_HOST_PORT=27017

# --- Prod profile (Docker secret master key, T2-A11) ------------------------
#
# Switch from .env-managed master key to a Docker secret (file outside .env):
#
#   mkdir -p secrets
#   openssl rand -base64 32 > secrets/master_key_v1.txt
#   chmod 400 secrets/master_key_v1.txt
#   docker compose --profile prod up --build
#
# The `ax-data-integration-prod` service ignores INTEGRATION_MASTER_KEY_V1 from
# this file and reads /run/secrets/master_key_v1 (mounted from secrets/master_key_v1.txt).
# Vault migration: have Vault Agent write to the same host path — no compose change.
# The secrets/ directory is gitignored.
