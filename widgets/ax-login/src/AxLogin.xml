<?xml version="1.0" encoding="utf-8"?>
<widget id="mendixone.axlogin.AxLogin" pluginWidget="true" needsEntityContext="true" offlineCapable="true"
        supportedPlatform="Web"
        xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>Ax Login</name>
    <description>Login form for the AX platform — ports the React SignInPage to a self-contained Mendix widget.</description>
    <icon/>
    <properties>
        <propertyGroup caption="General">
            <propertyGroup caption="Data">
                <property key="accountAttribute" type="attribute" required="true">
                    <caption>Account attribute</caption>
                    <description>String attribute on the surrounding data view — holds the username/email/phone the user types.</description>
                    <attributeTypes>
                        <attributeType name="String"/>
                    </attributeTypes>
                </property>
                <property key="passwordAttribute" type="attribute" required="true">
                    <caption>Password attribute</caption>
                    <description>String attribute that receives the password input.</description>
                    <attributeTypes>
                        <attributeType name="String"/>
                    </attributeTypes>
                </property>
            </propertyGroup>
            <propertyGroup caption="Actions">
                <property key="signInAction" type="action" required="true">
                    <caption>On sign in</caption>
                    <description>Microflow / nanoflow called when the form is submitted. Should validate credentials and navigate on success.</description>
                </property>
                <property key="signUpAction" type="action" required="false">
                    <caption>On sign up</caption>
                    <description>Optional — called when the user clicks the sign-up link below the form. Leave empty to hide the link.</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="State">
                <property key="errorMessage" type="expression" required="false">
                    <caption>Error message</caption>
                    <description>Expression returning the inline error text; shown in an alert above the form when non-empty.</description>
                    <returnType type="String"/>
                </property>
                <property key="isBusy" type="expression" required="false">
                    <caption>Is busy</caption>
                    <description>Expression returning true while sign-in is in flight; disables the form and shows the submit-button spinner.</description>
                    <returnType type="Boolean"/>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Appearance">
            <property key="logoUrl" type="image" required="false">
                <caption>Logo</caption>
                <description>Optional image shown above the form (centered, max-width 160px).</description>
            </property>
            <property key="accountLabel" type="textTemplate" required="false">
                <caption>Account field label</caption>
                <description/>
                <translations>
                    <translation lang="en_US">Account</translation>
                </translations>
            </property>
            <property key="accountPlaceholder" type="textTemplate" required="false">
                <caption>Account placeholder</caption>
                <description/>
                <translations>
                    <translation lang="en_US">Username, email or phone</translation>
                </translations>
            </property>
            <property key="passwordLabel" type="textTemplate" required="false">
                <caption>Password field label</caption>
                <description/>
                <translations>
                    <translation lang="en_US">Password</translation>
                </translations>
            </property>
            <property key="submitLabel" type="textTemplate" required="false">
                <caption>Submit button label</caption>
                <description/>
                <translations>
                    <translation lang="en_US">Sign in</translation>
                </translations>
            </property>
            <property key="signUpPrompt" type="textTemplate" required="false">
                <caption>Sign-up prompt</caption>
                <description>Text before the sign-up link.</description>
                <translations>
                    <translation lang="en_US">Don't have an account?</translation>
                </translations>
            </property>
            <property key="signUpLinkLabel" type="textTemplate" required="false">
                <caption>Sign-up link label</caption>
                <description/>
                <translations>
                    <translation lang="en_US">Sign up</translation>
                </translations>
            </property>
        </propertyGroup>
    </properties>
</widget>
