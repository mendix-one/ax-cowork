  "engines": {
    "node": ">=16"
  },
  "license": "Apache-2.0",
  "config": {
    "projectPath": "../../../ax-web-app-main",
    "mendixHost": "http://localhost:8080",
    "developmentPort": 3000
  },
  "packagePath": "one.mendix",
  "scripts": {
    "start": "cross-env CI=true pluggable-widgets-tools start:server",
    "dev": "cross-env CI=true pluggable-widgets-tools start:web",
    "build": "cross-env CI=true pluggable-widgets-tools build:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,xml,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,xml,md}\"",
    "prerelease": "npm run lint",
    "release": "cross-env CI=true pluggable-widgets-tools release:web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mendix/pluggable-widgets-tools": "^11.8.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/big.js": "^6.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sass": "^1.100.0",
    "tailwindcss": "^3.4.19",
    "typescript-eslint": "^8.60.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@mdi/js": "^7.4.47",
    "antd": "^6.4.3",
    "classnames": "^2.2.6"
  }
