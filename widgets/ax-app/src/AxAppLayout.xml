<?xml version="1.0" encoding="utf-8" ?>
<widget
  id="one.mendix.axapplayout.AxAppLayout"
  pluginWidget="true"
  offlineCapable="true"
  supportedPlatform="Web"
  xmlns="http://www.mendix.com/widget/1.0/"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd"
>
  <name>Ax App Layout</name>
  <description>Full-page layout shell for the app — header, left/right icon rails, switchable content
    views.
  </description>
  <icon/>
  <properties>
    <propertyGroup caption="General">
      <propertyGroup caption="Layout Mode">
        <property key="prpEnmMode" type="enumeration" defaultValue="SPLIT_VIEW_MULTIPLE">
          <caption>Layout mode</caption>
          <description>Layout display mode.</description>
          <enumerationValues>
            <enumerationValue key="FILL_CONTENT_PAGE">Fill Content Page</enumerationValue>
            <enumerationValue key="ONE_PANEL_PAGE">One Panel Page</enumerationValue>
            <enumerationValue key="SPLIT_VIEW_SINGLE">Split View Single</enumerationValue>
            <enumerationValue key="SPLIT_VIEW_MULTIPLE">Split View Multiple</enumerationValue>
          </enumerationValues>
        </property>
      </propertyGroup>
      <propertyGroup caption="Header Logo">
        <property key="prpImgLogo" type="image" required="false">
          <caption>Logo</caption>
          <description>Top-left brand logo image.</description>
        </property>
      </propertyGroup>
      <propertyGroup caption="Header Menus">
        <property key="prpBlnHeaderMenuApps" type="boolean" required="true" defaultValue="true">
          <caption>Menu: apps</caption>
          <description>Show header menu apps.</description>
        </property>
        <property key="prpBlnHeaderMenuWorldMap" type="boolean" required="true" defaultValue="true">
          <caption>Menu: world map</caption>
          <description>Show header menu world map.</description>
        </property>
        <property key="prpBlnHeaderMenuNotify" type="boolean" required="true" defaultValue="true">
          <caption>Menu: notify</caption>
          <description>Show header menu notify.</description>
        </property>
        <property key="prpBlnHeaderMenuAccount" type="boolean" required="true" defaultValue="true">
          <caption>Menu: account</caption>
          <description>Show header menu account.</description>
        </property>
        <property key="prpBlnHeaderMenuSettings" type="boolean" required="true" defaultValue="true">
          <caption>Menu: settings</caption>
          <description>Show header menu settings.</description>
        </property>
      </propertyGroup>
      <propertyGroup caption="Left Menus">
        <property key="prpDsLeftMenus" type="object" isList="true" required="false">
          <caption>The left panels</caption>
          <description/>
          <properties>
            <propertyGroup caption="Left Menu">
              <property key="prpLeftMenuNo" type="integer" required="true" defaultValue="1">
                <caption>Menu no</caption>
                <description />
              </property>
              <property key="prpLeftMenuIcon" type="icon" required="true">
                <caption>Menu icon</caption>
                <description />
              </property>
              <property key="prpLeftMenuCaption" type="textTemplate" required="true">
                <caption>Menu caption</caption>
                <description />
                <translations>
                  <translation lang="en_US">Panel Title</translation>
                </translations>
              </property>
              <property key="prpLeftMenuAction" type="action" required="true">
                <caption>Menu action</caption>
                <description />
              </property>
            </propertyGroup>
          </properties>
        </property>
      </propertyGroup>
      <propertyGroup caption="Right Menus">
        <property key="prpDsRightMenus" type="object" isList="true" required="false">
          <caption>The right panels</caption>
          <description/>
          <properties>
            <propertyGroup caption="Right Menu">
              <property key="prpRightMenuNo" type="integer" required="true" defaultValue="1">
                <caption>Menu no</caption>
                <description />
              </property>
              <property key="prpRightMenuIcon" type="icon" required="true">
                <caption>Menu icon</caption>
                <description />
              </property>
              <property key="prpRightMenuCaption" type="textTemplate" required="true">
                <caption>Menu caption</caption>
                <description />
                <translations>
                  <translation lang="en_US">Panel Title</translation>
                </translations>
              </property>
              <property key="prpRightMenuAction" type="action" required="true">
                <caption>Menu action</caption>
                <description />
              </property>
            </propertyGroup>
          </properties>
        </property>
      </propertyGroup>
      <propertyGroup caption="Left Panels">
        <property key="prpDsLeftPanels" type="object" isList="true" required="false">
          <caption>The left panels</caption>
          <description/>
          <properties>
            <propertyGroup caption="Left Panel">
              <property key="prpLeftPanelNo" type="integer" required="true" defaultValue="1">
                <caption>Panel no</caption>
                <description />
              </property>
              <property key="prpLeftPanelIcon" type="icon" required="true">
                <caption>Panel icon</caption>
                <description />
              </property>
              <property key="prpLeftPanelCaption" type="textTemplate" required="true">
                <caption>Panel caption</caption>
                <description />
                <translations>
                  <translation lang="en_US">Panel Title</translation>
                </translations>
              </property>
              <property key="prpLeftPanelContent" type="widgets" required="true">
                <caption>Panel content</caption>
                <description />
              </property>
            </propertyGroup>
          </properties>
        </property>
      </propertyGroup>
      <propertyGroup caption="Right Panels">
        <property key="prpDsRightPanels" type="object" isList="true" required="false">
          <caption>The right panels</caption>
          <description/>
          <properties>
            <propertyGroup caption="Right Panel">
              <property key="prpRightPanelNo" type="integer" required="true" defaultValue="1">
                <caption>Panel no</caption>
                <description />
              </property>
              <property key="prpRightPanelIcon" type="icon" required="true">
                <caption>Panel icon</caption>
                <description />
              </property>
              <property key="prpRightPanelCaption" type="textTemplate" required="true">
                <caption>Panel caption</caption>
                <description />
                <translations>
                  <translation lang="en_US">Panel Title</translation>
                </translations>
              </property>
              <property key="prpRightPanelContent" type="widgets" required="true">
                <caption>Panel content</caption>
                <description />
              </property>
            </propertyGroup>
          </properties>
        </property>
      </propertyGroup>
      <propertyGroup caption="Theme Configs">
        <property key="prpDsThemeConfigs" type="datasource" isList="true" required="false">
          <caption>Theme config list</caption>
          <description>The list with ony one them config</description>
        </property>
        <property key="prpSelThemeConfig" type="selection" dataSource="prpDsThemeConfigs">
          <caption>Theme config object</caption>
          <description>The selection object of Theme config</description>
          <selectionTypes>
            <selectionType name="Single" />
          </selectionTypes>
        </property>
      </propertyGroup>
    </propertyGroup>
    <propertyGroup caption="Contents">
      <propertyGroup caption="Page Content">
        <property key="prpWdgPageContent" type="widgets" required="false">
          <caption>Page content</caption>
          <description>Page main content</description>
        </property>
      </propertyGroup>
    </propertyGroup>
    <propertyGroup caption="Actions">
      <propertyGroup caption="Top Bar">
        <property key="prpActLogo" type="action" required="false">
          <caption>On click logo</caption>
          <description>Triggered by clicking the brand logo in the top bar.</description>
        </property>
        <property key="prpActApps" type="action" required="false">
          <caption>On click apps</caption>
          <description>Triggered by the apps / menu button in the top bar.</description>
        </property>
        <property key="prpActWorldMap" type="action" required="false">
          <caption>On click world map</caption>
          <description>Triggered by the world map button in the top bar.</description>
        </property>
        <property key="prpActNotify" type="action" required="false">
          <caption>On click notify</caption>
          <description>Triggered by the notifications button in the top bar.</description>
        </property>
        <property key="prpActAccount" type="action" required="false">
          <caption>On click account</caption>
          <description>Triggered by the account button in the top bar.</description>
        </property>
        <property key="prpActSettings" type="action" required="false">
          <caption>On click settings</caption>
          <description>Triggered by the settings button in the top bar.</description>
        </property>
      </propertyGroup>
    </propertyGroup>
    <propertyGroup caption="Labels">
      <propertyGroup caption="Top Bar">
        <property key="prpStrApps" type="string" required="false" defaultValue="Menu">
          <caption>Apps</caption>
          <description>Tooltip label for the apps / menu button.</description>
        </property>
        <property key="prpStrWorldMap" type="string" required="false" defaultValue="World Map">
          <caption>World Map</caption>
          <description>Tooltip label for the world map button.</description>
        </property>
        <property key="prpStrNotify" type="string" required="false" defaultValue="Notify">
          <caption>Notify</caption>
          <description>Tooltip label for the notifications button.</description>
        </property>
        <property key="prpStrAccount" type="string" required="false" defaultValue="Account">
          <caption>Account</caption>
          <description>Tooltip label for the account button.</description>
        </property>
        <property key="prpStrSettings" type="string" required="false" defaultValue="Settings">
          <caption>Settings</caption>
          <description>Tooltip label for the settings button.</description>
        </property>
      </propertyGroup>
    </propertyGroup>
  </properties>
</widget>
