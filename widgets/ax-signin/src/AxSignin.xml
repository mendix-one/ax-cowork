<?xml version="1.0" encoding="utf-8" ?>
<widget
  id="one.mendix.axsignin.AxSignin"
  pluginWidget="true"
  needsEntityContext="true"
  offlineCapable="true"
  supportedPlatform="Web"
  xmlns="http://www.mendix.com/widget/1.0/"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd"
>
    <name>Ax Signin</name>
    <description>Ax Signin - Ax Widgets Kit</description>
    <icon />
    <properties>
        <propertyGroup caption="General">
          <propertyGroup caption="Logo">
            <property key="prpImgLogoUrl" type="image" required="false">
              <caption>Logo</caption>
              <description>Optional logo shown above the form. Falls back to an account icon.</description>
            </property>
          </propertyGroup>
          <propertyGroup caption="Data">
            <property key="prpAttAccount" type="attribute" required="true">
              <caption>Account</caption>
              <description>Attribute bound to the account / username field.</description>
              <attributeTypes>
                <attributeType name="String" />
              </attributeTypes>
            </property>
            <property key="prpAttPassword" type="attribute" required="true">
              <caption>Password</caption>
              <description>Attribute bound to the password field.</description>
              <attributeTypes>
                <attributeType name="String" />
              </attributeTypes>
            </property>
            <property key="prpAttIsBusy" type="attribute" required="true">
              <caption>Is busy</caption>
              <description>Shows the loading state on the submit button while signing in.</description>
              <attributeTypes>
                <attributeType name="Boolean" />
              </attributeTypes>
            </property>
            <property key="prpTxtErrorMessage" type="attribute" required="true">
              <caption>Error message</caption>
              <description>Optional. When non-empty, an inline error alert is shown above the form.</description>
              <attributeTypes>
                <attributeType name="String" />
              </attributeTypes>
            </property>
            <property key="prpTxtSuccessMessage" type="attribute" required="true">
              <caption>Success message</caption>
              <description>Optional. When non-empty, an inline error alert is shown above the form.</description>
              <attributeTypes>
                <attributeType name="String" />
              </attributeTypes>
            </property>
          </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Background">
            <property key="prpBlnBackground" type="boolean" required="true" defaultValue="true">
                <caption>Show background</caption>
                <description>Show the animated digital background layer behind the sign-in card.</description>
            </property>
            <property key="prpTxtBgTitle" type="textTemplate" required="false">
                <caption>Background title</caption>
                <description>Headline shown over the animated background.</description>
                <translations>
                    <translation lang="en_US">Apply the Power of AI</translation>
                </translations>
            </property>
            <property key="prpTxtBgSubtitle" type="textTemplate" required="false">
                <caption>Background subtitle</caption>
                <description>Sub-headline shown under the background title.</description>
                <translations>
                    <translation lang="en_US">to Improve Engineering Planning</translation>
                </translations>
            </property>
            <property key="prpTxtBgTagline" type="textTemplate" required="false">
                <caption>Background tagline</caption>
                <description>Supporting line shown under the subtitle.</description>
                <translations>
                    <translation lang="en_US">Smarter roadmaps, data-driven estimates, and faster delivery.</translation>
                </translations>
            </property>
        </propertyGroup>
        <propertyGroup caption="Actions">
            <property key="prpActSignIn" type="action" required="true">
                <caption>On sign in</caption>
                <description>Microflow / nanoflow that authenticates the account.</description>
            </property>
            <property key="prpActSignUp" type="action" required="false">
                <caption>On sign up</caption>
                <description>Optional. When set, a sign-up link is shown below the form.</description>
            </property>
            <property key="prpActSso" type="action" required="false">
                <caption>On SSO sign in</caption>
                <description>Optional. When set, an SSO sign-in button is shown below the form.</description>
            </property>
        </propertyGroup>
        <propertyGroup caption="Labels">
            <property key="prpTxtAccountLabel" type="textTemplate" required="true">
                <caption>Account label</caption>
                <description />
                <translations>
                    <translation lang="en_US">Account</translation>
                </translations>
            </property>
            <property key="prpTxtAccountPlaceholder" type="textTemplate" required="true">
                <caption>Account placeholder</caption>
                <description />
                <translations>
                    <translation lang="en_US">Username, email or phone</translation>
                </translations>
            </property>
            <property key="prpTxtPasswordLabel" type="textTemplate" required="true">
                <caption>Password label</caption>
                <description />
                <translations>
                    <translation lang="en_US">Password</translation>
                </translations>
            </property>
            <property key="prpTxtSubmitLabel" type="textTemplate" required="true">
                <caption>Submit label</caption>
                <description />
                <translations>
                    <translation lang="en_US">Sign in</translation>
                </translations>
            </property>
            <property key="prpTxtSignUpPrompt" type="textTemplate" required="true">
                <caption>Sign-up prompt</caption>
                <description />
                <translations>
                    <translation lang="en_US">Don't have an account?</translation>
                </translations>
            </property>
            <property key="prpTxtSignUpLinkLabel" type="textTemplate" required="true">
                <caption>Sign-up link label</caption>
                <description />
                <translations>
                    <translation lang="en_US">Sign up</translation>
                </translations>
            </property>
            <property key="prpTxtSsoLabel" type="textTemplate" required="true">
                <caption>SSO button label</caption>
                <description />
                <translations>
                    <translation lang="en_US">Sign in with SSO</translation>
                </translations>
            </property>
        </propertyGroup>
    </properties>
</widget>
